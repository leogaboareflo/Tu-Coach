                      </div>
                      <span className="text-xs font-medium text-slate-400">{log.date}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        {/* 3. BREATHING EXERCISE TAB */}
        {activeTab === 'breathing' && (
          <div className="bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 shadow-sm text-center flex flex-col items-center">
            <h3 className="text-xl font-bold text-slate-800 mb-2">Respiración Guiada</h3>
            <p className="text-xs sm:text-sm text-slate-500 max-w-md mb-6">
              Sigue el ritmo del círculo visual para regular tu ritmo cardíaco y liberar tensión.
            </p>

            {/* Selector Technique */}
            <div className="inline-flex bg-slate-100 p-1 rounded-2xl mb-8 border border-slate-200">
              <button
                onClick={() => { setBreathingTechnique('478'); resetBreathing(); }}
                className={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${
                  breathingTechnique === '478' ? 'bg-white text-teal-700 shadow-sm' : 'text-slate-500 hover:text-slate-800'
                }`}
              >
                Técnica 4-7-8 (Relajante)
              </button>
              <button
                onClick={() => { setBreathingTechnique('box'); resetBreathing(); }}
                className={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${
                  breathingTechnique === 'box' ? 'bg-white text-teal-700 shadow-sm' : 'text-slate-500 hover:text-slate-800'
                }`}
              >
                Respiración Cuadrada 4-4-4-4
              </button>
            </div>

            {/* Breathing Visual Circle Container */}
            <div className="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center my-4">
              {/* Outer pulsing shadow ring */}
              <div
                className="absolute inset-0 rounded-full bg-teal-100/50 transition-transform duration-1000 ease-in-out"
                style={{ transform: `scale(${circleScale * 1.15})` }}
              />
              
              {/* Main Breathing Circle */}
              <div
                className="w-48 h-48 sm:w-56 sm:h-56 rounded-full bg-gradient-to-tr from-teal-400 to-indigo-400 text-white flex flex-col items-center justify-center shadow-lg transition-transform duration-1000 ease-in-out z-10"
                style={{ transform: `scale(${circleScale})` }}
              >
                <span className="text-2xl sm:text-3xl font-extrabold uppercase tracking-wider">
                  {breathPhase}
                </span>
                {isBreathingActive && (
                  <span className="text-4xl font-bold mt-1 animate-pulse">
                    {phaseTimer}
                  </span>
                )}
              </div>
            </div>

            {/* Controls */}
            <div className="flex items-center space-x-4 mt-6">
              <button
                onClick={toggleBreathing}
                className="flex items-center space-x-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3 rounded-2xl shadow-md transition-all active:scale-95"
              >
                {isBreathingActive ? <Pause className="w-5 h-5" /> : <Play className="w-5 h-5" />}
                <span>{isBreathingActive ? 'Pausar' : 'Iniciar'}</span>
              </button>
              <button
                onClick={resetBreathing}
                className="p-3 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl transition-colors border border-slate-200"
                title="Reiniciar"
              >
                <RotateCcw className="w-5 h-5" />
              </button>
            </div>

            <p className="text-xs text-slate-400 mt-6 max-w-xs">
              {breathingTechnique === '478' 
                ? 'Inhala en 4s, mantén en 7s y exhala suavemente en 8s.' 
                : 'Inhala en 4s, mantén en 4s, exhala en 4s y haz pausa en 4s.'}
            </p>
          </div>
        )}

        {/* 4. GRATITUDE JOURNAL TAB */}
        {activeTab === 'gratitude' && (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            {/* Input Form */}
            <div className="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm">
              <h3 className="text-lg font-bold text-slate-800 mb-1">Diario de Gratitud</h3>
              <p className="text-xs text-slate-500 mb-5">
                Menciona 3 cosas simples o valiosas por las que te sientes agradecido/a el día de hoy:
              </p>

              <form onSubmit={handleSaveGratitude} className="space-y-3">
                <div className="flex items-center space-x-2">
                  <span className="w-6 h-6 rounded-full bg-amber-100 text-amber-700 font-bold text-xs flex items-center justify-center shrink-0">1</span>
                  <input
                    type="text"
                    required
                    value={item1}
                    onChange={(e) => setItem1(e.target.value)}
                    placeholder="Ej. El abrazo de mi ser querido"
                    className="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
                  />
                </div>
                <div className="flex items-center space-x-2">
                  <span className="w-6 h-6 rounded-full bg-amber-100 text-amber-700 font-bold text-xs flex items-center justify-center shrink-0">2</span>
                  <input
                    type="text"
                    value={item2}
                    onChange={(e) => setItem2(e.target.value)}
                    placeholder="Ej. Descansar un momento por la tarde"
                    className="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
                  />
                </div>
                <div className="flex items-center space-x-2">
                  <span className="w-6 h-6 rounded-full bg-amber-100 text-amber-700 font-bold text-xs flex items-center justify-center shrink-0">3</span>
                  <input
                    type="text"
                    value={item3}
                    onChange={(e) => setItem3(e.target.value)}
                    placeholder="Ej. Tener comida deliciosa"
                    className="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
                  />
                </div>

                <button
                  type="submit"
                  className="w-full mt-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition-colors text-sm"
                >
                  Guardar Reflexión de Hoy
                </button>
              </form>
            </div>

            {/* Past Entries */}
            <div className="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col">
              <h3 className="text-md font-bold text-slate-800 mb-4 flex items-center gap-2">
                <BookOpen className="w-4 h-4 text-amber-500" />
                Reflexiones Pasadas
              </h3>

              <div className="flex-1 overflow-y-auto space-y-4 pr-1 max-h-[380px]">
                {gratitudeEntries.length === 0 ? (
                  <p className="text-xs text-slate-400 italic text-center py-8">Aún no tienes entradas registradas.</p>
                ) : (
                  gratitudeEntries.map((entry) => (
                    <div key={entry.id} className="bg-amber-50/40 border border-amber-100 p-4 rounded-2xl">
                      <span className="text-xs font-semibold text-amber-700 block mb-2">{entry.date}</span>
                      <ul className="space-y-1.5">
                        {entry.items.map((item, idx) => (
                          <li key={idx} className="text-xs text-slate-700 flex items-start space-x-2">
                            <span className="text-amber-500 font-bold">•</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                )}
              </div>
            </div>

          </div>
        )}

        {/* 5. EMOTIONAL SUPPORT CHATBOT */}
        {activeTab === 'chat' && (
          <div className="bg-white border border-slate-100 rounded-3xl shadow-sm flex flex-col h-[520px] overflow-hidden">
            {/* Chat Header */}
            <div className="p-4 bg-slate-50 border-b border-slate-100 flex items-center space-x-3">
              <div className="w-9 h-9 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-sm">
                🤖
              </div>
              <div>
                <h3 className="text-sm font-bold text-slate-800">Coach Emocional</h3>
                <p className="text-xs text-emerald-600 flex items-center gap-1 font-medium">
                  <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                  Espacio seguro y empático
                </p>
              </div>
            </div>

            {/* Messages Area */}
            <div className="flex-1 p-4 overflow-y-auto space-y-3 bg-slate-50/30">
              {messages.map((msg) => (
                <div
                  key={msg.id}
                  className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}
                >
                  <div
                    className={`max-w-[80%] p-3.5 rounded-2xl text-xs sm:text-sm leading-relaxed ${
                      msg.sender === 'user'
                        ? 'bg-indigo-600 text-white rounded-br-none shadow-sm'
                        : 'bg-white border border-slate-100 text-slate-700 rounded-bl-none shadow-sm'
                    }`}
                  >
                    {msg.text}
                  </div>
                </div>
              ))}
            </div>

            {/* Input Box */}
            <form onSubmit={handleSendMessage} className="p-3 bg-white border-t border-slate-100 flex items-center gap-2">
              <input
                type="text"
                value={chatInput}
                onChange={(e) => setChatInput(e.target.value)}
                placeholder="Escribe lo que sientes o piensas aquí..."
                className="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
              />
              <button
                type="submit"
                className="p-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition-colors shrink-0"
              >
                <Send className="w-4 h-4" />
              </button>
            </form>
          </div>
        )}

      </main>

      {/* EMERGENCY GROUNDING MODAL (SOS) */}
      {showEmergencyModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-rose-100 relative animate-scaleUp">
            
            <button
              onClick={() => setShowEmergencyModal(false)}
              className="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-2 rounded-full hover:bg-slate-100"
            >
              ✕
            </button>

            <div className="flex items-center space-x-3 mb-4">
              <div className="p-2.5 bg-rose-100 text-rose-600 rounded-2xl">
                <ShieldAlert className="w-6 h-6" />
              </div>
              <div>
                <h3 className="text-lg font-bold text-slate-800">Técnica de Anclaje (Grounding)</h3>
                <p className="text-xs text-slate-500">Recupera la calma paso a paso reconectando con tus sentidos</p>
              </div>
            </div>

            {/* Current Step Card */}
            <div className="bg-rose-50/50 border border-rose-100 p-6 rounded-2xl my-4 text-center">
              <div className="text-5xl mb-3">{groundingSteps[groundingStep].icon}</div>
              <h4 className="text-md font-bold text-rose-900 mb-1">
                {groundingSteps[groundingStep].title}
              </h4>
              <p className="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {groundingSteps[groundingStep].desc}
              </p>
            </div>

            {/* Progress Dots */}
            <div className="flex justify-center space-x-2 my-4">
              {groundingSteps.map((_, idx) => (
                <div
                  key={idx}
                  className={`w-2.5 h-2.5 rounded-full transition-all ${
                    idx === groundingStep ? 'bg-rose-500 w-6' : 'bg-slate-200'
                  }`}
                />
              ))}
            </div>

            {/* Modal Controls */}
            <div className="flex justify-between items-center mt-6">
              <button
                disabled={groundingStep === 0}
                onClick={() => setGroundingStep((prev) => prev - 1)}
                className="px-4 py-2 text-xs font-semibold text-slate-500 disabled:opacity-30 hover:text-slate-800"
              >
                Anterior
              </button>

              {groundingStep < groundingSteps.length - 1 ? (
                <button
                  onClick={() => setGroundingStep((prev) => prev + 1)}
                  className="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs rounded-xl shadow-sm transition-colors"
                >
                  Siguiente paso
                </button>
              ) : (
                <button
                  onClick={() => setShowEmergencyModal(false)}
                  className="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-sm transition-colors"
                >
                  ¡Me siento mejor!
                </button>
              )}
            </div>

          </div>
        </div>
      )}

      {/* Footer */}
      <footer className="mt-auto border-t border-slate-200/60 bg-white/50 py-4 text-center text-xs text-slate-400">
        <p>Tu Coach • Tu bienestar es importante. Si estás en crisis, acude a profesionales o líneas de emergencia de tu localidad.</p>
      </footer>

    </div>
  );
}
